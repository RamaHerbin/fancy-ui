{
	"name": "fancy-ui-svelte-example-workspace",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5295 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 5295 --strictPort",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test -c playwright.config.ts"
	},
	"dependencies": {
		"fancy-ui-svelte": "workspace:*"
	},
	"devDependencies": {
		"@lucide/svelte": "^0.562.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^25.2.3",
		"jsdom": "^28.0.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vitest": "^4.0.18"
	}
