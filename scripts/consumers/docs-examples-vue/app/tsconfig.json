{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"jsx": "preserve",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"skipLibCheck": false,
		"noEmit": true,
		"isolatedModules": true
	},
	"vueCompilerOptions": { "strictTemplates": true },
	"include": ["src/**/*.ts", "src/**/*.vue"]
}
