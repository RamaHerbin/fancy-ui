{
	"name": "fancy-ui-react",
	"version": "0.1.0",
	"description": "Animated UI components for React — the React counterpart of fancy-ui-svelte. WebGL, GSAP and CSS motion, styled with Tailwind CSS v4.",
	"license": "MIT",
	"type": "module",
	"homepage": "https://github.com/RamaHerbin/fancy-ui/tree/main/react",
	"bugs": {
		"url": "https://github.com/RamaHerbin/fancy-ui/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RamaHerbin/fancy-ui.git",
		"directory": "react"
	},
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json && node scripts/strip-dts-css-imports.mjs && node scripts/check-dist-names.mjs && node scripts/check-dist-shape.mjs && node scripts/smoke-dist.mjs",
		"check": "tsc --noEmit",
		"check:matrix": "node scripts/check-matrix.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "pnpm run build && publint"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"tailwind.css",
		"PORTING.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./cameleon": {
			"types": "./dist/cameleon/index.d.ts",
			"import": "./dist/cameleon/index.js",
			"default": "./dist/cameleon/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./tailwind.css": "./tailwind.css",
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"cameleon": [
				"./dist/cameleon/index.d.ts"
			]
		}
	},
	"sideEffects": [
		"**/*.css"
	],
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"dependencies": {
		"@chenglou/pretext": "^0.0.5",
		"@types/canvas-confetti": "^1.9.0",
		"canvas-confetti": "^1.9.4",
		"clsx": "^2.1.1",
		"gsap": "^3.14.2",
		"tailwind-merge": "^3.4.0",
		"three": "^0.183.2"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.6.3",
		"@types/three": "^0.183.1",
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^4.6.0",
		"jsdom": "^26.1.0",
		"publint": "^0.3.18",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"typescript": "^5.8.0",
		"vite": "^7.0.0",
		"vitest": "^4.0.0"
	},
	"engines": {
		"node": ">=20.19.0"
	}
}
